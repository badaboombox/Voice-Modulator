FILE_TYPE=LIBRARY_PARTS;
PRIMITIVE '1064','1064_Other';
  PIN
    '+':
      PIN_NUMBER='(1)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    '-':
      PIN_NUMBER='(2)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
  END_PIN;
  BODY
    PART_NAME='1064';
    PHYS_DES_PREFIX='MK';
    NO_LOAD_CHECK='TRUE';
    PIN_COUNT='2';
    BODY_NAME='1064';
    JEDEC_TYPE='1064';
  END_BODY;
END_PRIMITIVE;
END.
